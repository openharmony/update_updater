import("//base/update/updater/updater_default_cfg.gni")
import("//build/test.gni")

MODULE_OUTPUT_PATH = "updater/updater"
updater_path = rebase_path("${updater_absolutely_path}", ".")

ohos_unittest("sdcard_update_unittest") {
  defines = [ "UPDATER_UT" ]
  testonly = true
  resource_config_file = "${updater_path}/test/unittest/test_data/ohos_test.xml"
  module_out_path = MODULE_OUTPUT_PATH
  sources = [
    "sdcard_update_unittest.cpp",
    "${updater_path}/services/sdcard_update/action/sdcard_update_action.cpp",
    "${updater_path}/services/sdcard_update/adapter/sdcard_update_adapter.cpp",
    "${updater_path}/services/sdcard_update/framework/sdcard_update_chain_builder.cpp",
    "${updater_path}/services/sdcard_update/framework/sdcard_update_group.cpp",
    "${updater_path}/services/sdcard_update/framework/sdcard_update_step.cpp",
    "${updater_path}/services/sdcard_update/manager/sdcard_update_process_manager.cpp",
    "${updater_path}/services/sdcard_update/service/sdcard_update.cpp",
  ]
  include_dirs = [
    "${updater_path}/interfaces/kits/include",
    "${updater_path}/services",
    "${updater_path}/services/common",
    "${updater_path}/services/include",
    "${updater_path}/services/sdcard_update/action",
    "${updater_path}/services/sdcard_update/adapter",
    "${updater_path}/services/sdcard_update/framework",
    "${updater_path}/services/sdcard_update/manager",
    "${updater_path}/services/sdcard_update/service",
    "${updater_path}/services/ui",
    "${updater_path}/services/ui/include",
    "${updater_path}/utils/include",
  ]

  deps = [
    "${updater_path}/services/log:libupdaterlog_shared",
    "${updater_path}/services/fs_manager:libfsmanager",
    "${updater_path}/utils:libutils",
  ]

  external_deps = [
    "bounds_checking_function:libsec_static",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "init:libbegetutil_static",
  ]
  configs = [ "${updater_path}/test/unittest:utest_config" ]
  install_enable = true
  part_name = "updater"
}
