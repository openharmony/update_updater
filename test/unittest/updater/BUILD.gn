import("//base/update/updater/updater_default_cfg.gni")
import("//build/test.gni")
 
MODULE_OUTPUT_PATH = "updater/updater"
updater_path = rebase_path("${updater_absolutely_path}", ".")
 
ohos_unittest("updater_test") {
  resource_config_file = "${updater_path}/test/unittest/test_data/ohos_test.xml"
  module_out_path = MODULE_OUTPUT_PATH
  sources = [
    "${updater_path}/test/unittest/updater/updater_unittest.cpp",
  ]
 
  sources += [
    "${updater_path}/services/updater.cpp",
  ]
 
  include_dirs = [
    "${updater_path}/services/include/fs_manager",
    "${updater_path}/services/fs_manager",
    "${updater_path}/services/include/log",
    "${updater_path}/services/include/updater",
    "${updater_path}/services/sdcard_update",
    "${updater_path}/services/ui",
    "${updater_path}/services/ui/include",
    "${updater_path}/services/ui/view",
    "${updater_path}/services/write_state",
    "${updater_path}/test/unittest/updater",
  ]
 
  deps = [
    "${updater_path}/services/package:libupdaterpackage_shared",
    "${updater_path}/utils:libutils",
  ]
 
  configs = [ "${updater_path}/test/unittest:utest_config" ]
 
  external_deps = [
    "bounds_checking_function:libsec_static",
    "bzip2:libbz2",
    "cJSON:cjson",
    "c_utils:utils",
    "drivers_interface_input:libinput_proxy_1.0",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "init:libbegetutil_static",
    "init:libfsmanager_static_real",
    "openssl:libcrypto_shared",
    "openssl:libssl_static",
  ]

  if (updater_ui_support) {
    external_deps += [
      "graphic_utils_lite:utils_lite",
      "ui_lite:libupdater_layout",
    ]
  }
 
  install_enable = true
  part_name = "updater"
  defines = [ "OPENSSL_SUPPRESS_DEPRECATED" ]
}