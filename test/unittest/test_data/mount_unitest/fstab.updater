#<src> <mnt_point> <type> <mnt_flags and options> <fs_mgr_flags>
/dev/block/by-name/misc       /misc       emmc      defaults        defaults
/dev/block/by-name/cache      /cache      ext4      defaults        defaults
/dev/block/by-name/userdata   /data       hmfs      defaults        length=-16384,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M,nofail
/dev/block/by-name/userdata   /internaldata       hmfs      defaults        length=-16384,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M,nofail
/dev/block/by-name/splash2    /splash2    ext4      defaults        defaults
/dev/block/mmcblk1p1          /sdcard     vfat      defaults        defaults
/dev/block/mmcblk1            /sdcard     vfat      defaults        defaults
/dev/block/sde1               /sdcard     vfat      defaults        defaults
